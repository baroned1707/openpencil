+/// Register every face of one blob with `provider`. A user-imported variable
+/// font also gets one instance per CSS weight step its `wght` axis can reach,
+/// so a bold request resolves to a real bold master instead of the regular
+/// default plus synthetic bold. Bundled fonts keep their single instance.
+fn register_blob_faces(
+    provider: &mut TypefaceFontProvider,
+    mgr: &FontMgr,
+    blob: &FontBlob,
+) -> bool {
+    let Some(base) = typeface_from_bytes(mgr, &blob.bytes) else {
+        return false;
+    };
+    let instances = if blob.source == FontSource::Imported {
+        weight_instances(&base)
+    } else {
+        Vec::new()
+    };
+    provider.register_typeface(base, None);
+    for instance in instances {
+        provider.register_typeface(instance, None);
+    }
+    true
+}
+
+/// Clones of a variable `typeface` at each CSS weight step (100..900) inside
+/// its `wght` range, except the step `base` already sits on. A clone is kept
+/// only when the backend reports the weight we asked for: the provider picks a
+/// face by its reported style, so an instance that still claimed another weight
+/// would shadow the real one.
+fn weight_instances(base: &Typeface) -> Vec<Typeface> {
+    const WGHT: skia_safe::FourByteTag = skia_safe::FourByteTag::from_chars('w', 'g', 'h', 't');
+    let Some(axes) = base.variation_design_parameters() else {
+        return Vec::new();
+    };
+    let Some(axis) = axes.iter().find(|axis| axis.tag == WGHT) else {
+        return Vec::new();
+    };
+    let base_weight = *base.font_style().weight();
+    (1..=9)
+        .map(|step| step * 100)
+        .filter(|&weight| {
+            weight != base_weight && (weight as f32) >= axis.min && (weight as f32) <= axis.max
+        })
+        .filter_map(|weight| {
+            let coordinates = [skia_safe::font_arguments::variation_position::Coordinate {
+                axis: WGHT,
+                value: weight as f32,
+            }];
+            let arguments = skia_safe::FontArguments::new().set_variation_design_position(
+                skia_safe::font_arguments::VariationPosition {
+                    coordinates: &coordinates,
+                },
+            );
+            base.clone_with_arguments(&arguments)
+                .filter(|clone| *clone.font_style().weight() == weight)
+        })
+        .collect()
+}
